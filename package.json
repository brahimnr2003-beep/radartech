{
  "name": "radartech",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file-if-exists=.env.local src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "recolectar": "tsx --env-file-if-exists=.env.local src/recolector/index.ts",
    "buscar": "tsx --env-file-if-exists=.env.local src/recolector/buscar.ts",
    "importar": "tsx --env-file-if-exists=.env.local src/recolector/importar.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.108",
    "@vercel/analytics": "^2.0.1",
    "ai": "^7.0.157",
    "better-auth": "^1.7.10",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}

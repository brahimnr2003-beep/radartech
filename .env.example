# Copia este archivo a .env.local (no se sube a git).
# Valor para la base de datos local de docker-compose.yml:
DATABASE_URL=postgres://radartech:radartech@localhost:5433/radartech

# Clave de Gemini para el recolector (https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=

# Panel de administración (Better Auth + GitHub)
# Secreto: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Email de la cuenta de GitHub que puede entrar al panel
ADMIN_EMAIL=
# OAuth App de GitHub con callback http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Búsqueda de eventos en internet (https://tavily.com, plan gratuito sin tarjeta)
TAVILY_API_KEY=

# Opcional: abrir la web local desde otro dispositivo de la red (IP del ordenador)
ORIGENES_DESARROLLO=
